{
  "name": "limbo",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first skeleton where every op declares its merge rule, plus a Kiro kit that blocks merges that diverge.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node kit/scripts/op-lint-all.mjs",
    "site:hero": "node kit/scripts/site-hero.mjs",
    "test": "vitest run --project unit --project limbo",
    "props": "vitest run --project props",
    "props:full": "node kit/scripts/props-full.mjs",
    "e2e": "playwright test",
    "e2e:live": "playwright test --project=live",
    "share": "node kit/scripts/kiro-share.mjs",
    "gate": "node kit/scripts/gate-integrity.mjs",
    "e2e:spike:10": "node kit/scripts/e2e-spike-10.mjs",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "test:coverage": "vitest run --coverage",
    "coverage:gaps": "node kit/scripts/coverage-gaps.mjs",
    "kiro:check": "node kit/scripts/kiro-root-check.mjs",
    "e2e:ci": "playwright test --project=spike --project=basecamp --project=aftershock --project=basecamp-shell --project=aftershock-shell --project=ui-polish-basecamp --project=ui-polish-aftershock --project=judge --project=landing"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "4.10.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "workbox-build>glob": "14.0.2"
    }
  }
}
